# Supabase (required for app)
VITE_SUPABASE_URL=https://awryxczjacqrgjlctrjc.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Supabase Edge Functions: set via Supabase secrets, not here.
# Menu extraction and voice ordering both use this key. Never put it in VITE_ vars.
# GOOGLE_GEMINI_API_KEY=your-google-ai-key
# PHONE_WEBHOOK_SECRET=long-random-string
# DRIVE_THRU_DEVICE_SECRET=long-random-string
# PUBLIC_APP_URL=https://your-app.example
# Square sandbox POS. Leave unset until the app is created. Do not mark Square connected without these.
# SQUARE_APP_ID=
# SQUARE_APP_SECRET=
# SQUARE_ENVIRONMENT=sandbox
# Food-order card payments use the existing STRIPE_SECRET_KEY with Stripe Connect.
# STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET stay server-side. Redeploy stripe-webhook after payment changes.

# Google sign-in: enable the Google provider in Supabase → Authentication → Providers.
# Add your site origin (and /onboarding, /admin/dashboard) under Redirect URLs.

